<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- 2 · Selección de horario -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ucsur.pe.vista.HorarioVista" styleClass="fondo">
    <top>
        <VBox>
            <padding><Insets top="10" left="24" right="24"/></padding>
            <fx:include source="encabezado.fxml"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <HBox alignment="TOP_CENTER">
                <padding><Insets top="24" left="24" right="24" bottom="40"/></padding>
                <HBox spacing="36" maxWidth="1380" HBox.hgrow="ALWAYS">
                    <!-- Columna izquierda: póster y ficha de la película -->
                    <VBox spacing="16" minWidth="312" prefWidth="312" maxWidth="312">
                        <HBox>
                            <Button text="← Volver a la cartelera" styleClass="btn-secundario, btn-chico" onAction="#onVolver"/>
                        </HBox>
                        <StackPane fx:id="poster" alignment="CENTER" maxWidth="-Infinity"/>
                        <VBox styleClass="horario-ficha" spacing="14">
                            <Label fx:id="lblTitulo" styleClass="horario-titulo-peli" wrapText="true"/>
                            <FlowPane fx:id="generos" hgap="8" vgap="6"/>
                            <HBox spacing="10">
                                <VBox styleClass="dato-oscuro" spacing="2" alignment="CENTER" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label text="Duración" styleClass="dato-oscuro-etiqueta"/>
                                    <Label fx:id="lblDuracion" styleClass="dato-oscuro-valor"/>
                                </VBox>
                                <VBox styleClass="dato-oscuro" spacing="2" alignment="CENTER" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label text="Clasificación" styleClass="dato-oscuro-etiqueta"/>
                                    <Label fx:id="lblClasificacion" styleClass="dato-oscuro-valor"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="10">
                                <Button text="Leer sinopsis" styleClass="btn-oscuro" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onSinopsis"/>
                                <Button fx:id="btnTrailer" text="Ver tráiler" styleClass="btn-oscuro" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onTrailer"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Columna derecha: días y horarios por formato de sala -->
                    <VBox spacing="18" HBox.hgrow="ALWAYS" minWidth="620" maxWidth="1032">
                        <VBox styleClass="horario-cabecera" spacing="14">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Elige tu horario" styleClass="titulo-claro"/>
                                    <HBox fx:id="cajaSedeFecha" alignment="CENTER_LEFT" spacing="8">
                                        <Label fx:id="lblSedeFecha" styleClass="texto-claro"/>
                                    </HBox>
                                </VBox>
                                <Label fx:id="lblResumenDia" styleClass="horario-resumen-pill" visible="false" managed="false"/>
                            </HBox>
                            <FlowPane fx:id="dias" hgap="10" vgap="10"/>
                        </VBox>
                        <Label fx:id="lblMensaje" styleClass="mensaje, mensaje-claro" visible="false" managed="false"/>
                        <VBox fx:id="formatos" spacing="18"/>
                    </VBox>
                </HBox>
            </HBox>
        </ScrollPane>
    </center>
</BorderPane>
