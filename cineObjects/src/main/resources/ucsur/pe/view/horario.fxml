<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- 2 · Selección de horario -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ucsur.pe.vista.HorarioVista" styleClass="fondo">
    <top>
        <VBox>
            <padding><Insets top="10" left="24" right="24"/></padding>
            <fx:include source="encabezado.fxml"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <HBox alignment="TOP_CENTER">
                <padding><Insets top="28" left="24" right="24" bottom="40"/></padding>
                <HBox spacing="56" maxWidth="1440">
                    <!-- Columna izquierda: la película -->
                    <VBox spacing="16" minWidth="320" maxWidth="320">
                        <Button text="← Volver a la cartelera" styleClass="btn-secundario" prefWidth="260" onAction="#onVolver"/>
                        <StackPane fx:id="poster" alignment="CENTER_LEFT">
                            <VBox.margin><Insets top="8"/></VBox.margin>
                        </StackPane>
                        <Label fx:id="lblTitulo" styleClass="titulo-claro" wrapText="true"/>
                        <FlowPane fx:id="generos" hgap="8" vgap="6"/>
                        <HBox spacing="12">
                            <VBox styleClass="caja-dato" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <Label text="Duración" styleClass="nota"/>
                                <Label fx:id="lblDuracion" styleClass="etiqueta-fuerte"/>
                            </VBox>
                            <VBox styleClass="caja-dato" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <Label text="Clasificación" styleClass="nota"/>
                                <Label fx:id="lblClasificacion" styleClass="etiqueta-fuerte"/>
                            </VBox>
                        </HBox>
                        <HBox spacing="12">
                            <Button text="Leer sinopsis" styleClass="btn-secundario" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onSinopsis"/>
                            <Button fx:id="btnTrailer" text="Ver tráiler" styleClass="btn-secundario" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onTrailer"/>
                        </HBox>
                    </VBox>

                    <!-- Columna derecha: días y horarios por formato de sala -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS" minWidth="640" maxWidth="1000">
                        <Label text="Elige tu horario" styleClass="titulo-claro"/>
                        <Label fx:id="lblSedeFecha" styleClass="texto-claro"/>
                        <FlowPane fx:id="dias" hgap="10" vgap="10">
                            <VBox.margin><Insets top="10" bottom="6"/></VBox.margin>
                        </FlowPane>
                        <Label fx:id="lblMensaje" styleClass="mensaje, mensaje-claro" visible="false" managed="false"/>
                        <VBox fx:id="formatos" spacing="14"/>
                    </VBox>
                </HBox>
            </HBox>
        </ScrollPane>
    </center>
</BorderPane>
