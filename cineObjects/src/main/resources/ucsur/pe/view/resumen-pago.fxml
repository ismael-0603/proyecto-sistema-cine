<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- 8 · Resumen y pago -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ucsur.pe.vista.ResumenPagoVista" styleClass="fondo">
    <top>
        <fx:include fx:id="encabezado" source="encabezado-compra.fxml"/>
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
            <VBox alignment="CENTER">
                <padding><Insets top="24" left="24" right="24" bottom="24"/></padding>
                <HBox alignment="CENTER" spacing="36" maxWidth="1400" maxHeight="-Infinity">
                    <VBox styleClass="tarjeta" spacing="4" HBox.hgrow="ALWAYS" minWidth="560" maxWidth="800">
                        <Label text="Resumen de la compra" styleClass="tarjeta-titulo">
                            <VBox.margin><Insets bottom="10"/></VBox.margin>
                        </Label>
                        <VBox fx:id="filas"/>
                        <HBox fx:id="filaTotal"/>

                        <Label text="Código de cupón" styleClass="etiqueta-fuerte">
                            <VBox.margin><Insets top="18" bottom="6"/></VBox.margin>
                        </Label>
                        <HBox spacing="12">
                            <TextField fx:id="txtCupon" promptText="Ingresa tu cupón" HBox.hgrow="ALWAYS" onAction="#onAplicarCupon"/>
                            <Button text="Aplicar" styleClass="btn-secundario" prefWidth="120" onAction="#onAplicarCupon"/>
                            <Button fx:id="btnQuitarCupon" text="Quitar" styleClass="btn-secundario" prefWidth="95" visible="false" managed="false" onAction="#onQuitarCupon"/>
                        </HBox>
                        <Label text="Promoción" styleClass="etiqueta-fuerte">
                            <VBox.margin><Insets top="14" bottom="6"/></VBox.margin>
                        </Label>
                        <HBox spacing="12">
                            <ComboBox fx:id="cmbPromocion" promptText="Elegir promoción" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Aplicar" styleClass="btn-secundario" prefWidth="120" onAction="#onAplicarPromocion"/>
                            <Button fx:id="btnQuitarPromocion" text="Quitar" styleClass="btn-secundario" prefWidth="95" visible="false" managed="false" onAction="#onQuitarPromocion"/>
                        </HBox>
                        <Label fx:id="lblMensaje" styleClass="mensaje" visible="false" managed="false">
                            <VBox.margin><Insets top="8"/></VBox.margin>
                        </Label>
                        <Label fx:id="lblSocio" styleClass="nota-suave" wrapText="true">
                            <VBox.margin><Insets top="8"/></VBox.margin>
                        </Label>
                    </VBox>

                    <VBox styleClass="tarjeta" spacing="16" minWidth="420" prefWidth="560" maxWidth="560">
                        <Label text="Método de pago" styleClass="tarjeta-titulo"/>
                        <Button fx:id="btnTarjeta" styleClass="opcion, opcion-pago" maxWidth="Infinity" onAction="#onTarjeta"/>
                        <Button fx:id="btnBilletera" styleClass="opcion, opcion-pago" maxWidth="Infinity" onAction="#onBilletera"/>
                        <Label text="Los datos de pago se ingresan en la pasarela de pago, no en esta pantalla."
                               styleClass="nota" wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox styleClass="pie">
            <Button text="← Volver" styleClass="btn-secundario" onAction="#onVolver"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Total" styleClass="pie-etiqueta"/>
            <Label fx:id="lblPieTotal" styleClass="pie-total"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnPagar" styleClass="btn-primario" onAction="#onPagar"/>
        </HBox>
    </bottom>
</BorderPane>
