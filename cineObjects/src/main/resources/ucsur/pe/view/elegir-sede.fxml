<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- 22 · Elegir sede -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ucsur.pe.vista.ElegirSedeVista" styleClass="fondo">
    <top>
        <VBox>
            <padding><Insets top="10" left="24" right="24"/></padding>
            <fx:include fx:id="encabezado" source="encabezado.fxml"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox alignment="TOP_CENTER" spacing="10">
                <padding><Insets top="100" left="24" right="24" bottom="40"/></padding>
                <Label text="¿En qué sede quieres comprar?" styleClass="titulo-claro"/>
                <Label text="La cartelera, los horarios y las butacas son los de la sede que elijas."
                       styleClass="subtitulo-claro"/>
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre o distrito" maxWidth="695">
                    <VBox.margin><Insets top="22" bottom="26"/></VBox.margin>
                </TextField>
                <Label fx:id="lblMensaje" styleClass="mensaje, mensaje-claro" visible="false" managed="false"/>
                <FlowPane fx:id="sedes" hgap="25" vgap="21" maxWidth="1385" prefWrapLength="1385"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
