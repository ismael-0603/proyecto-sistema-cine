<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- 24 · Recuperar entradas (código de 6 dígitos al correo) -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ucsur.pe.vista.RecuperarVista" styleClass="fondo">
    <top>
        <VBox>
            <padding><Insets top="10" left="24" right="24"/></padding>
            <fx:include source="encabezado.fxml"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
            <VBox alignment="CENTER">
                <padding><Insets top="24" left="24" right="24" bottom="32"/></padding>
                <VBox spacing="12" maxWidth="820" maxHeight="-Infinity" alignment="TOP_CENTER">
                    <HBox maxWidth="Infinity" alignment="CENTER_LEFT">
                        <Button text="← Volver a la cartelera" styleClass="btn-secundario, btn-chico" onAction="#onVolver"/>
                    </HBox>

                    <!-- Respaldo cuando el cliente ya tiene sesión iniciada -->
                    <VBox fx:id="cajaConSesion" styleClass="tarjeta" spacing="12" maxWidth="720" visible="false" managed="false">
                        <padding><Insets top="34" left="48" right="48" bottom="34"/></padding>
                        <Label text="Ya iniciaste sesión" styleClass="titulo"/>
                        <Label text="Puedes ver, imprimir o reenviar todas tus compras directamente desde tu cuenta."
                               styleClass="etiqueta" wrapText="true"/>
                        <Button text="Ir a Mis compras" styleClass="btn-primario" maxWidth="Infinity" onAction="#onMisCompras">
                            <VBox.margin><Insets top="10"/></VBox.margin>
                        </Button>
                    </VBox>

                    <!-- Flujo de recuperación en 2 pasos: correo -> código de 6 dígitos -->
                    <VBox fx:id="cajaFormulario" styleClass="tarjeta" spacing="10" maxWidth="720">
                        <padding><Insets top="34" left="48" right="48" bottom="34"/></padding>
                        <Label text="Recupera tus entradas" styleClass="titulo"/>
                        <Label fx:id="lblInstruccion" styleClass="etiqueta" wrapText="true"
                               text="Escribe el correo con el que compraste y te enviaremos un código de 6 dígitos."/>

                        <Label text="Correo electrónico" styleClass="etiqueta-campo">
                            <VBox.margin><Insets top="16"/></VBox.margin>
                        </Label>
                        <TextField fx:id="txtCorreo" promptText="nombre@correo.com" onAction="#onEnviarCodigo"/>
                        <Button fx:id="btnEnviar" text="Enviar código" styleClass="btn-primario" maxWidth="Infinity" onAction="#onEnviarCodigo">
                            <VBox.margin><Insets top="8"/></VBox.margin>
                        </Button>

                        <VBox fx:id="pasoCodigo" spacing="10" visible="false" managed="false">
                            <Label text="Código de 6 dígitos" styleClass="etiqueta-campo">
                                <VBox.margin><Insets top="6"/></VBox.margin>
                            </Label>
                            <TextField fx:id="txtCodigo" promptText="000000" styleClass="campo-codigo" onAction="#onVerificar"/>
                            <Button text="Ver mis entradas" styleClass="btn-primario" maxWidth="Infinity" onAction="#onVerificar">
                                <VBox.margin><Insets top="8"/></VBox.margin>
                            </Button>
                            <HBox alignment="CENTER" spacing="18">
                                <Button text="Reenviar código" styleClass="btn-link" onAction="#onEnviarCodigo"/>
                                <Button text="Usar otro correo" styleClass="btn-link" onAction="#onOtroCorreo"/>
                            </HBox>
                        </VBox>

                        <Label fx:id="lblMensaje" styleClass="mensaje" visible="false" managed="false" wrapText="true"/>
                    </VBox>

                    <!-- Lista de compras recuperadas (cuando el correo tiene más de una compra confirmada) -->
                    <VBox fx:id="cajaResultados" styleClass="tarjeta" spacing="14" maxWidth="820" visible="false" managed="false">
                        <padding><Insets top="30" left="36" right="36" bottom="30"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Tus compras confirmadas" styleClass="titulo"/>
                                <Label fx:id="lblResumenCorreo" styleClass="etiqueta" wrapText="true"/>
                            </VBox>
                            <Button text="Usar otro correo" styleClass="btn-secundario, btn-chico" onAction="#onOtroCorreo"/>
                        </HBox>
                        <VBox fx:id="listaCompras" spacing="10"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
