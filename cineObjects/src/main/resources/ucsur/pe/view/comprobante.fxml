<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<!-- 9 · Comprobante -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ucsur.pe.vista.ComprobanteVista" styleClass="fondo">
    <top>
        <VBox>
            <padding><Insets top="10" left="24" right="24"/></padding>
            <fx:include fx:id="encabezado" source="encabezado.fxml"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
            <VBox alignment="CENTER">
                <padding><Insets top="24" left="24" right="24" bottom="28"/></padding>
                <HBox alignment="CENTER" spacing="28" maxWidth="1380" maxHeight="-Infinity">
                    <VBox styleClass="tarjeta" spacing="4" HBox.hgrow="ALWAYS" minWidth="560" maxWidth="830">
                        <padding><Insets top="30" left="40" right="40" bottom="30"/></padding>
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <VBox.margin><Insets bottom="18"/></VBox.margin>
                            <StackPane styleClass="check-exito">
                                <Group>
                                    <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" styleClass="icono-svg" scaleX="1.1" scaleY="1.1"/>
                                </Group>
                            </StackPane>
                            <VBox>
                                <Label text="¡Compra exitosa!" styleClass="titulo"/>
                                <Label fx:id="lblSerie" styleClass="etiqueta"/>
                            </VBox>
                        </HBox>
                        <VBox fx:id="filas"/>
                        <HBox fx:id="filaTotal"/>
                        <Region styleClass="separador-ticket">
                            <VBox.margin><Insets top="14" bottom="10"/></VBox.margin>
                        </Region>
                        <Label fx:id="lblMedio" styleClass="nota-suave"/>
                    </VBox>

                    <VBox styleClass="tarjeta" spacing="14" minWidth="420" prefWidth="530" maxWidth="530">
                        <padding><Insets top="30" left="36" right="36" bottom="30"/></padding>
                        <Label text="Tu código QR" styleClass="tarjeta-titulo"/>
                        <HBox alignment="CENTER">
                            <StackPane fx:id="marcoQr" styleClass="marco-qr"/>
                        </HBox>
                        <Label fx:id="lblCodigo" styleClass="nota" maxWidth="Infinity" alignment="CENTER"/>
                        <Label text="Muéstralo en la entrada de la sala y para recoger tu pedido en dulcería."
                               styleClass="nota" wrapText="true" maxWidth="Infinity" alignment="CENTER"/>
                        <VBox fx:id="cajaPuntos" styleClass="caja-dato">
                            <Label fx:id="lblPuntos" styleClass="etiqueta-fuerte"/>
                            <Label fx:id="lblSaldo" styleClass="nota"/>
                        </VBox>
                        <HBox spacing="12" alignment="CENTER">
                            <Button fx:id="btnEnviar" text="Enviar al correo" styleClass="btn-secundario" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onEnviar"/>
                            <Button fx:id="btnImprimir" text="Imprimir" styleClass="btn-secundario" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onImprimir"/>
                        </HBox>
                        <Label fx:id="lblMensaje" styleClass="mensaje" visible="false" managed="false"/>
                        <Button text="Volver al inicio" styleClass="btn-primario" maxWidth="Infinity" onAction="#onInicio"/>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
