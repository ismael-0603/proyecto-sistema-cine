<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Encabezado compartido (pantallas del cliente y modo panel de dulcería/administración) -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ucsur.pe.vista.EncabezadoVista" styleClass="encabezado">
    <fx:include fx:id="logo" source="logo.fxml"/>
    <Button fx:id="btnSede" styleClass="btn-sede, btn-pastilla" onAction="#onCambiarSede">
        <HBox.margin><Insets left="14"/></HBox.margin>
    </Button>
    <Button fx:id="btnMenuAdmin" styleClass="btn-toggle-menu" visible="false" managed="false" onAction="#onAlternarMenu">
        <HBox.margin><Insets left="10"/></HBox.margin>
    </Button>
    <!-- Modo panel (dulcería y administración): título y sede del empleado -->
    <VBox fx:id="cajaTitulo" alignment="CENTER_LEFT" spacing="2" visible="false" managed="false">
        <HBox.margin><Insets left="14"/></HBox.margin>
        <Label fx:id="lblTituloPanel" styleClass="encabezado-titulo"/>
        <Label fx:id="lblSubtituloPanel" styleClass="nota"/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="btnComprar" text="Ir a comprar entradas" styleClass="btn-secundario, btn-pastilla"
            visible="false" managed="false" onAction="#onComprar"/>
    <Button fx:id="btnPerdiste" text="¿Perdiste tus entradas?" styleClass="btn-nav, btn-pastilla" onAction="#onPerdiste"/>
    <Button fx:id="btnPromociones" text="Promociones" styleClass="btn-nav, btn-pastilla" onAction="#onPromociones"/>
    <Button fx:id="btnSesion" styleClass="btn-primario, btn-pastilla" onAction="#onSesion"/>
    <Button fx:id="btnVolver" styleClass="btn-secundario, btn-pastilla" onAction="#onVolver"/>
</HBox>
