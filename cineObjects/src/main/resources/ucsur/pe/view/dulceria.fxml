<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- 7 · Dulcería -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ucsur.pe.vista.DulceriaVista" styleClass="fondo">
    <top>
        <fx:include fx:id="encabezado" source="encabezado-compra.fxml"/>
    </top>
    <center>
        <HBox alignment="TOP_CENTER">
            <padding><Insets top="16" left="24" right="24" bottom="16"/></padding>
            <HBox spacing="32" maxWidth="1400" HBox.hgrow="ALWAYS">
                <VBox spacing="14" HBox.hgrow="ALWAYS">
                    <Label text="¿Quieres acompañar tu función?" styleClass="titulo-claro"/>
                    <HBox fx:id="categorias" styleClass="barra-filtros" maxWidth="-Infinity"/>
                    <Label fx:id="lblMensaje" styleClass="mensaje, mensaje-claro" visible="false" managed="false"/>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="productos" hgap="24" vgap="24">
                            <padding><Insets bottom="10"/></padding>
                        </FlowPane>
                    </ScrollPane>
                </VBox>

                <VBox styleClass="tarjeta" spacing="12" minWidth="400" prefWidth="420" maxWidth="420">
                    <Label text="Tu pedido" styleClass="tarjeta-titulo"/>
                    <HBox><Label fx:id="lblEntradas" styleClass="nota"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblMontoEntradas" styleClass="nota"/></HBox>
                    <Separator/>
                    <Label text="Dulcería" styleClass="nota"/>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                        <VBox fx:id="lineas" spacing="8"/>
                    </ScrollPane>
                    <Separator/>
                    <HBox><Label text="Subtotal dulcería" styleClass="nota"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblSubtotalDulceria" styleClass="nota"/></HBox>
                    <Separator/>
                    <HBox><Label text="Total" styleClass="etiqueta-fuerte"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblTotal" styleClass="etiqueta-fuerte"/></HBox>
                    <Label text="ⓘ  Sabor de bebida y golosina sujetos a stock de la sede. Canchita sin refill."
                           styleClass="aviso, nota" wrapText="true" maxWidth="Infinity"/>
                </VBox>
            </HBox>
        </HBox>
    </center>
    <bottom>
        <HBox styleClass="pie">
            <Button text="← Cambiar butacas" styleClass="btn-secundario" onAction="#onCambiarButacas"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Total" styleClass="pie-etiqueta"/>
            <Label fx:id="lblPieTotal" styleClass="pie-total"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Continuar sin dulcería" styleClass="btn-secundario" prefWidth="250" minWidth="-Infinity" onAction="#onSinDulceria"/>
            <Button text="Actualizar pedido y continuar" styleClass="btn-primario" prefWidth="320" minWidth="-Infinity" onAction="#onContinuar"/>
        </HBox>
    </bottom>
</BorderPane>
