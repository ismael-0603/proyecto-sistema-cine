<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- 12.1 · Mi cuenta (empleado) -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ucsur.pe.vista.MiCuentaEmpleadoVista" styleClass="fondo">
    <top>
        <VBox>
            <padding><Insets top="10" left="24" right="24"/></padding>
            <fx:include fx:id="encabezado" source="encabezado.fxml"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED">
            <VBox alignment="TOP_CENTER">
                <padding><Insets top="24" left="24" right="24" bottom="32"/></padding>
                <VBox spacing="10" maxWidth="1380">
                    <HBox>
                        <Button fx:id="btnVolver" text="← Volver" styleClass="btn-secundario, btn-chico" onAction="#onVolver"/>
                    </HBox>
                    <Label text="Mi cuenta" styleClass="titulo-claro"/>
                    <Label fx:id="lblSubtitulo" styleClass="nota-clara"/>
                    <HBox spacing="24">
                        <VBox.margin><Insets top="14"/></VBox.margin>
                        <VBox styleClass="tarjeta" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <padding><Insets top="26" left="28" right="28" bottom="26"/></padding>
                            <Label text="Datos personales" styleClass="tarjeta-titulo">
                                <VBox.margin><Insets bottom="10"/></VBox.margin>
                            </Label>
                            <GridPane hgap="40" vgap="8">
                                <Label text="Nombres" styleClass="nota" GridPane.rowIndex="0"/>
                                <Label fx:id="lblNombres" styleClass="nota" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Apellidos" styleClass="nota" GridPane.rowIndex="1"/>
                                <Label fx:id="lblApellidos" styleClass="nota" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="DNI" styleClass="nota" GridPane.rowIndex="2"/>
                                <Label fx:id="lblDni" styleClass="nota" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>
                            <Label text="Correo electrónico" styleClass="etiqueta-campo">
                                <VBox.margin><Insets top="14"/></VBox.margin>
                            </Label>
                            <TextField fx:id="txtCorreo"/>
                            <Label text="Teléfono" styleClass="etiqueta-campo">
                                <VBox.margin><Insets top="8"/></VBox.margin>
                            </Label>
                            <TextField fx:id="txtTelefono"/>
                            <Label text="DNI y nombres no se pueden cambiar desde el kiosco." styleClass="nota"/>
                            <Label fx:id="lblMensaje" styleClass="mensaje" visible="false" managed="false"/>
                            <Button text="Guardar cambios" styleClass="btn-primario" maxWidth="Infinity" onAction="#onGuardar">
                                <VBox.margin><Insets top="10"/></VBox.margin>
                            </Button>
                            <Button text="Cerrar sesión" styleClass="btn-secundario" maxWidth="Infinity" onAction="#onCerrarSesion"/>
                        </VBox>
                        <VBox styleClass="tarjeta" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <padding><Insets top="30" left="38" right="38" bottom="30"/></padding>
                            <Label text="Mi trabajo" styleClass="tarjeta-titulo">
                                <VBox.margin><Insets bottom="10"/></VBox.margin>
                            </Label>
                            <GridPane hgap="60" vgap="10">
                                <Label text="Rol" styleClass="nota" GridPane.rowIndex="0"/>
                                <Label fx:id="lblRol" styleClass="etiqueta-fuerte" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Sede" styleClass="nota" GridPane.rowIndex="1"/>
                                <Label fx:id="lblSede" styleClass="etiqueta-fuerte" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="Turno" styleClass="nota" GridPane.rowIndex="2"/>
                                <Label fx:id="lblTurno" styleClass="etiqueta-fuerte" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>
                            <Label text="Rol, sede y turno vienen del registro del empleado y no se cambian desde el kiosco."
                                   styleClass="nota" wrapText="true"/>
                            <Separator>
                                <VBox.margin><Insets top="14" bottom="14"/></VBox.margin>
                            </Separator>
                            <Label text="Accesos de tu rol" styleClass="tarjeta-titulo"/>
                            <Button text="Ir al Panel de dulcería" styleClass="btn-primario" maxWidth="Infinity" onAction="#onPanelDulceria">
                                <VBox.margin><Insets top="8"/></VBox.margin>
                            </Button>
                            <Button fx:id="btnAdministracion" text="Ir a Administración" styleClass="btn-secundario" maxWidth="Infinity" onAction="#onAdministracion"/>
                            <Separator>
                                <VBox.margin><Insets top="14" bottom="14"/></VBox.margin>
                            </Separator>
                            <Label text="PIN de acceso" styleClass="tarjeta-titulo"/>
                            <Label text="Se pide al volver a tu panel desde tu cuenta personal." styleClass="nota" wrapText="true"/>
                            <HBox spacing="12">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="PIN actual" styleClass="etiqueta-campo"/>
                                    <PasswordField fx:id="txtPinActual"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="PIN nuevo" styleClass="etiqueta-campo"/>
                                    <PasswordField fx:id="txtPinNuevo"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Confirmar PIN" styleClass="etiqueta-campo"/>
                                    <PasswordField fx:id="txtPinConfirmar"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="lblMensajePin" styleClass="mensaje" visible="false" managed="false"/>
                            <Button text="Cambiar PIN" styleClass="btn-secundario" maxWidth="Infinity" onAction="#onCambiarPin"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
