<?xml version="1.0" encoding="UTF-8"?>
<!-- Como en el ejemplo MVCone: el botón «Run» de NetBeans abre la interfaz gráfica (mvn clean javafx:run).
     La demo por consola sigue disponible con mvn exec:java. -->
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>javafx:run</goal>
        </goals>
    </action>
</actions>
